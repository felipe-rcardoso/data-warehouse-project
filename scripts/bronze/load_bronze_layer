"""
===============================================================================
Bronze Layer Ingestion: CRM & ERP Source Files
===============================================================================
Purpose:
    Loads raw CSV files from the landing volume into Delta tables in the
    bronze layer (Medallion architecture). Tables are fully reloaded
    (truncate & load) on each run.

Sources:
    - CRM: cust_info, prd_info, sales_details
    - ERP: CUST_AZ12, LOC_A101, PX_CAT_G1V2

Target:
    dev_dw.bronze.<source>_<table_name>

Process:
    1. Reads each CSV from /Volumes/dev_dw/bronze/landing_files
    2. Adds audit columns (_ingestion_ts, _source_file)
    3. Overwrites the target Delta table
    4. Captures load metrics per table (status, rows, duration, errors)
    5. Appends the run summary to dev_dw.bronze.load_log
    6. Raises an exception if any table fails, so the job is marked as failed

Usage:
    Run as a Databricks notebook or as a task in a Databricks Job.
    To add a new table, add an entry to LOAD_CONFIG.

Warning:
    This script overwrites the bronze tables. Any data not present in the
    source files will be lost.
===============================================================================
"""


import time
from datetime import datetime
from delta.tables import DeltaTable
from pyspark.sql import functions as F
from pyspark.sql.types import StructType, StructField, StringType, TimestampType, LongType, DoubleType

# Definir o caminho dos arquivos dentro do volume
VOLUME_PATH = '/Volumes/dev_dw/bronze/landing_files'
CATALOG_SCHEMA = 'dev_dw.bronze'

LOAD_CONFIG = [
    {"source": "crm", "file": "source_crm/cust_info.csv", "table": "crm_cust_info"},
    {"source": "crm", "file": "source_crm/prd_info.csv", "table": "crm_prd_info"},
    {"source": "crm", "file": "source_crm/sales_details.csv", "table": "crm_sales_details"},
    {"source": "erp", "file": "source_erp/CUST_AZ12.csv", "table": "erp_cust_az12"},
    {"source": "erp", "file": "source_erp/LOC_A101.csv", "table": "erp_loc_a101"},
    {"source": "erp", "file": "source_erp/PX_CAT_G1V2.csv", "table": "erp_px_cat_g1v2"},
]

def load_bronze_table(cfg: dict) -> dict:

    """Carrega o CSV para uma tabela e retorna métricas da carga."""
    
    file_path = f"{VOLUME_PATH}/{cfg['file']}"
    full_table = f"{CATALOG_SCHEMA}.{cfg['table']}"
    start_ts = datetime.now()
    start = time.perf_counter()

    result = {
        "source": cfg["source"],
        "file": cfg["file"],
        "table": full_table,
        "start_ts": start_ts,
        "status": None,
        "rows_loaded": None,
        "duration_sec": None,
        "error_message": None,
    }

    try:
        print(f"[{start_ts:%H:%M:%S}] Carregando {cfg['file']} -> {full_table}")

        df = (
            spark.read.format("csv")
            .option("header", "true")
            .option("inferSchema", "true")
            .load(file_path)
            
            .withColumn("_ingestion_ts", F.current_timestamp())
            .withColumn("_source_file", F.col("_metadata.file_path"))
        )

        (
            df.write.format("delta")
            .mode("overwrite")
            .option("overwriteSchema", "true")
            .saveAsTable(full_table)
        )

        # Número de linhas pelo histórico do Delta (evita um df.count())
        rows = (
            DeltaTable.forName(spark, full_table)
            .history(1)
            .select("operationMetrics.numOutputRows")
            .collect()[0][0]
        )

        result["status"] = "SUCCESS"
        result["rows_loaded"] = int(rows) if rows else 0

    except Exception as e:
        result["status"] = "FAILED"
        result["error_message"] = str(e)[:1000]
        print(f"ERRO em {full_table}: {str(e)[:300]}")

    finally:
        result["duration_sec"] = round(time.perf_counter() - start, 2)
        print(f"{result['status']} | {result['rows_loaded']} linhas | {result['duration_sec']}s")

    return result

# Execução
batch_start = time.perf_counter()
results = [load_bronze_table(cfg) for cfg in LOAD_CONFIG]
batch_duration = round(time.perf_counter() - batch_start, 2)

LOG_SCHEMA = StructType([
    StructField("source", StringType()),
    StructField("file", StringType()),
    StructField("table", StringType()),
    StructField("start_ts", TimestampType()),
    StructField("status", StringType()),
    StructField("rows_loaded", LongType()),
    StructField("duration_sec", DoubleType()),
    StructField("error_message", StringType()),
])

# Resumo
df_log = spark.createDataFrame(results, schema=LOG_SCHEMA).withColumn("batch_duration_sec", F.lit(batch_duration))
display(df_log)

# Persistir o log para histórico de cargas
df_log.write.format("delta").mode("append").saveAsTable(f"{CATALOG_SCHEMA}.load_log")

# Falhar o job se alguma tabela falhou 
failed = [r["table"] for r in results if r["status"] == "FAILED"]
if failed:
    raise Exception(f"Carga da bronze falhou para: {failed}")

print(f"Carga da bronze concluída em {batch_duration}s")
